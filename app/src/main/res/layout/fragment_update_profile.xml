<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="updateProfileView"
            type="com.mamits.citymatic.viewmodel.fragment.ProfileFragmentViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/fragmentDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_15sdp"
                    android:paddingTop="@dimen/_15sdp"
                    android:paddingEnd="@dimen/_15sdp"
                    android:paddingBottom="@dimen/_15sdp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="@dimen/_44sdp"
                        android:layout_height="@dimen/_44sdp"
                        android:src="@drawable/back_icon" />

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="Edit Profile"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_15ssp"
                        app:fontName="Poppins-Medium.ttf" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/toolbar"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_25sdp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/img_person_card"
                            android:layout_width="@dimen/_73sdp"
                            android:layout_height="@dimen/_73sdp"
                            android:layout_centerVertical="true"

                            android:backgroundTint="@color/white"
                            app:cardCornerRadius="@dimen/_50sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/img_person"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/ColorD9D9D9"
                                android:scaleType="fitXY"
                                tools:src="@drawable/poster" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btn_change_photo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_60sdp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_25sdp"
                            android:layout_toEndOf="@+id/img_person_card"
                            android:backgroundTint="@color/black"
                            app:cardCornerRadius="@dimen/_5sdp">

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Change Photo"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_12ssp"
                                app:fontName="Poppins-Regular.ttf" />

                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="59dp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:background="@drawable/edit_text_background"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="@dimen/_7sdp">

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.5"
                                android:text="First name*"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_9ssp"
                                app:fontName="Poppins-Regular.ttf" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/et_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:inputType="textPersonName"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="59dp"
                            android:layout_weight="1"
                            android:background="@drawable/edit_text_background"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="@dimen/_7sdp">

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.5"
                                android:text="Last name*"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_9ssp"
                                app:fontName="Poppins-Regular.ttf" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/et_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:inputType="textPersonName"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="59dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edit_text_background"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/_7sdp">

                        <com.mamits.citymatic.ui.customviews.CustomTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.5"
                            android:text="Mobileno.*"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_9ssp"
                            app:fontName="Poppins-Regular.ttf" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/et_mobile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:inputType="textEmailAddress"
                            android:text=""
                            android:textColor="@color/tab_unselect"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="59dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edit_text_background"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/_7sdp">

                        <com.mamits.citymatic.ui.customviews.CustomTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.5"
                            android:text="Email iD*"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_9ssp"
                            app:fontName="Poppins-Regular.ttf" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:inputType="textEmailAddress"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginVertical="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:backgroundTint="@color/black"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Save Changes"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        app:fontName="Poppins-Regular.ttf" />

                </androidx.cardview.widget.CardView>

            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>
</layout>