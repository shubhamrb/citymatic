<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_15sdp"
    android:background="@color/dim_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/bundle_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:backgroundTint="@color/gray"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardElevation="0dp">

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:id="@+id/txt_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.5"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingEnd="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:text="BASIC"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    app:fontName="Poppins-Medium.ttf" />
            </androidx.cardview.widget.CardView>

            <RadioButton
                android:id="@+id/btn_radio"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/color_orange"
                android:checked="true"
                android:visibility="gone" />
        </RelativeLayout>


        <com.mamits.citymatic.ui.customviews.CustomTextViewHtml
            android:id="@+id/txt_plan_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:alpha="0.7"
            android:includeFontPadding="false"
            android:text="✓ Removal of toiletries ✓ Cleaning of high dust cobwebs✓ Cleaning of exhaust fans"
            android:textColor="@color/black"
            android:textSize="@dimen/_10ssp"
            app:fontName="Poppins-Regular.ttf" />

        <LinearLayout
            android:id="@+id/ll_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.mamits.citymatic.ui.customviews.CustomTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:includeFontPadding="false"
                android:text="Add to cart"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                app:fontName="Poppins-Regular.ttf" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="For "
                    android:textColor="@color/black"
                    android:textSize="@dimen/_15ssp"
                    app:fontName="Poppins-Bold.ttf" />

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:id="@+id/txt_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="₹250"
                    android:textColor="@color/color_orange"
                    android:textSize="@dimen/_15ssp"
                    app:fontName="Poppins-Bold.ttf" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>