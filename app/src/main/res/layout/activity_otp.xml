<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="otpView"
            type="com.mamits.citymatic.viewmodel.activity.OtpActivityViewModel" />
    </data>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_25sdp">

            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:src="@drawable/city_matic_logo" />

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="@string/app_name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18ssp"
                    app:fontName="MontserratAlternatesSemiBold.ttf" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/toolbar"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:gravity="bottom"
                android:orientation="vertical">


                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:id="@+id/h1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter OTP"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14ssp"
                    app:fontName="Poppins-Medium.ttf" />

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:id="@+id/h2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Please enter the OTP recieved on"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    app:fontName="Poppins-Regular.ttf" />

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:id="@+id/txt_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="+91 879 978 7985"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11ssp"
                    app:fontName="Poppins-Medium.ttf" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/_7sdp">

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:text="OTP*"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_9ssp"
                        app:fontName="Poppins-Regular.ttf" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_otp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:inputType="phone"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:id="@+id/btn_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="Resend"
                    android:textColor="@color/color_orange"
                    android:textSize="@dimen/_13ssp"
                    app:fontName="Poppins-Medium.ttf" />


            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_verify_otp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:layout_above="@+id/btn_issue"
                android:layout_marginTop="@dimen/_30sdp"
                android:backgroundTint="@color/black"
                app:cardCornerRadius="@dimen/_5sdp">

                <com.mamits.citymatic.ui.customviews.CustomTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Continue"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12ssp"
                    app:fontName="Poppins-Regular.ttf" />

            </androidx.cardview.widget.CardView>

            <com.mamits.citymatic.ui.customviews.CustomTextView
                android:id="@+id/btn_issue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_30sdp"
                android:text="Have an issue?"
                android:textColor="@color/color_orange"
                android:textSize="@dimen/_10ssp"
                app:fontName="Poppins-Medium.ttf" />
        </RelativeLayout>

    </ScrollView>

</layout>