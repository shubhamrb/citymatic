<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_10sdp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="@dimen/_107sdp"
        android:layout_height="@dimen/_136sdp"
        android:layout_centerHorizontal="true"
        android:layout_margin="@dimen/_2sdp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="@dimen/_8sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/img_sub_cat"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.mamits.citymatic.ui.customviews.CustomTextView
                android:id="@+id/txt_sub_cat_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:text="Railway"
                android:textColor="@color/black"
                android:textSize="@dimen/_15ssp"
                app:fontName="Poppins-Bold.ttf" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>