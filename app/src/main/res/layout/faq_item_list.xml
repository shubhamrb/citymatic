<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_15sdp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.mamits.citymatic.ui.customviews.CustomTextView
                android:id="@+id/txt_ques"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:includeFontPadding="false"
                android:text="This is a question no 011"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp"
                app:fontName="Poppins-Medium.ttf" />

            <ImageView
                android:id="@+id/img_arrow"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:rotation="90"
                android:src="@drawable/arrow_right_icon" />
        </RelativeLayout>

        <com.mamits.citymatic.ui.customviews.CustomTextViewHtml
            android:id="@+id/txt_ans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:alpha="0.7"
            android:includeFontPadding="false"
            android:text="Create and edit text documents directly in your browser – no dedicated software required. Several people can work at the same time, and every change is saved automatically."
            android:textColor="@color/black"
            android:textSize="@dimen/_10ssp"
            android:visibility="gone"
            app:fontName="Poppins-Regular.ttf" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@color/gray" />
    </LinearLayout>

</RelativeLayout>