<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.mamits.citymatic.viewmodel.fragment.OrderDetailsViewModel" />

        <variable
            name="addressModel"
            type="com.mamits.citymatic.data.model.address.AddressDataModel" />

        <variable
            name="cartDetailModel"
            type="com.mamits.citymatic.data.model.orders.OrderDetailDataModel" />

        <variable
            name="address"
            type="String" />

        <variable
            name="totalPrice"
            type="Double" />

        <variable
            name="couponApplied"
            type="Boolean" />

        <import type="android.view.View" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_15sdp"
            android:paddingTop="@dimen/_15sdp"
            android:paddingEnd="@dimen/_15sdp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:src="@drawable/back_icon" />

            <com.mamits.citymatic.ui.customviews.CustomTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="My Bookings"
                android:textColor="@color/black"
                android:textSize="@dimen/_15ssp"
                app:fontName="Poppins-Medium.ttf" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/rl_happy_code"
            android:layout_below="@+id/toolbar"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/root_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_15sdp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FAFFF5"
                    app:cardCornerRadius="@dimen/_5sdp"
                    app:contentPadding="@dimen/_15sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/color_orange"
                    app:strokeWidth="0.5dp"
                    tools:visibility="visible">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/rl_product"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#E2F4CF"
                            app:cardCornerRadius="@dimen/_5sdp"
                            app:contentPadding="@dimen/_10sdp"
                            app:layout_constraintTop_toTopOf="parent">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/bundle_card"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:backgroundTint="@color/color_orange"
                                    android:visibility="visible"
                                    app:cardCornerRadius="@dimen/_5sdp"
                                    app:cardElevation="0dp">

                                    <com.mamits.citymatic.ui.customviews.CustomTextView
                                        android:id="@+id/txt_order_id"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/_3sdp"
                                        android:includeFontPadding="false"
                                        android:letterSpacing="0.2"
                                        android:paddingStart="@dimen/_5sdp"
                                        android:paddingTop="@dimen/_3sdp"
                                        android:paddingEnd="@dimen/_5sdp"
                                        android:paddingBottom="@dimen/_3sdp"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_10ssp"
                                        app:fontName="Poppins-Regular.ttf"
                                        tools:text="#2147483647" />
                                </androidx.cardview.widget.CardView>

                                <com.mamits.citymatic.ui.customviews.CustomTextView
                                    android:id="@+id/txt_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/bundle_card"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:layout_marginTop="@dimen/_6sdp"
                                    android:alpha="0.5"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:text="Jan 01, 2023 | 01:00 pm"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_10ssp"
                                    app:fontName="Poppins-Medium.ttf" />

                                <com.mamits.citymatic.ui.customviews.CustomTextView
                                    android:id="@+id/txt_product_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/txt_date"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:text="Bathroom Cleaning"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_12ssp"
                                    app:fontName="Poppins-Medium.ttf" />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/img_card"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:backgroundTint="@color/white"
                                    app:cardCornerRadius="@dimen/_5sdp">

                                    <ImageView
                                        android:id="@+id/img_sub_cat"
                                        android:layout_width="@dimen/_78sdp"
                                        android:layout_height="@dimen/_53sdp"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/poster" />
                                </androidx.cardview.widget.CardView>

                            </RelativeLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_breakup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_25sdp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@+id/rl_product">

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_service_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="@{cartDetailModel.name}"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Regular.ttf"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="Bathroom Cleaning" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_product_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="@{`₹`+cartDetailModel.price}"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Medium.ttf"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="₹450.00" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_qty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.5"
                                android:singleLine="true"
                                android:text="@{`Qty `+cartDetailModel.quantity+`x`}"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Regular.ttf"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_service_name"
                                tools:text="Qty 2x" />

                            <View
                                android:id="@+id/view_qty_divider"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_1sdp"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:background="@drawable/dashed_line"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_qty" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_gross_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:singleLine="true"
                                android:text="Gross Total"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Regular.ttf"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_qty_divider" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_gross_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:singleLine="true"
                                android:text="@{`₹`+totalPrice}"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Bold.ttf"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_qty_divider"
                                tools:text="$450.00" />

                            <View
                                android:id="@+id/view_gross_divider"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_1sdp"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:background="@drawable/dashed_line"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_gross_label" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_coupon_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:singleLine="true"
                                android:text="Coupon Discount"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Regular.ttf"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_gross_divider" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_coupon_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:singleLine="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                app:fontName="Poppins-Regular.ttf"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_gross_divider"
                                tools:text="$450.00" />

                            <View
                                android:id="@+id/view_coupon_divider"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_1sdp"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:background="@drawable/dashed_line"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_coupon_label" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_net_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:singleLine="true"
                                android:text="Net Total"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Regular.ttf"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_coupon_divider" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:id="@+id/txt_net_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:singleLine="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold"
                                app:fontName="Poppins-Bold.ttf"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_coupon_divider"
                                tools:text="$450.00" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/history_shimmer" />
                </com.facebook.shimmer.ShimmerFrameLayout>
            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>

        <RelativeLayout
            android:id="@+id/rl_happy_code"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_above="@+id/card_vendor"
            android:layout_marginTop="@dimen/_15sdp"
            android:background="@color/black"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp">

            <com.mamits.citymatic.ui.customviews.CustomTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="Happycode"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                app:fontName="Poppins-Medium.ttf" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_19sdp"
                    app:cardBackgroundColor="@color/color_orange">

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:id="@+id/txt_code1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp"
                        app:fontName="Poppins-Medium.ttf"
                        tools:text="8" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_19sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/color_orange">

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:id="@+id/txt_code2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp"
                        app:fontName="Poppins-Medium.ttf"
                        tools:text="8" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_19sdp"
                    android:layout_marginStart="@dimen/_4sdp"

                    app:cardBackgroundColor="@color/color_orange">

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:id="@+id/txt_code3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp"
                        app:fontName="Poppins-Medium.ttf"
                        tools:text="8" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_19sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/color_orange">

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:id="@+id/txt_code4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp"
                        app:fontName="Poppins-Medium.ttf"
                        tools:text="8" />

                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_vendor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/rl_happy_code">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_20sdp"
                android:paddingVertical="@dimen/_10sdp">

                <RelativeLayout
                    android:id="@+id/rl_section1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/ll_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <com.mamits.citymatic.ui.customviews.CustomTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Cost till now"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_9ssp"
                            app:fontName="Poppins-Regular.ttf" />

                        <com.mamits.citymatic.ui.customviews.CustomTextView
                            android:id="@+id/txt_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="₹00.00"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12ssp"
                            app:fontName="Poppins-Medium.ttf" />

                    </LinearLayout>
                </RelativeLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rl_section1"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/img_person_card"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_41sdp"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="@dimen/_50sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/img_person"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/ColorD9D9D9"
                            android:scaleType="fitXY"
                            tools:src="@drawable/poster" />
                    </androidx.cardview.widget.CardView>

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:id="@+id/txt_vendor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:alpha="0.5"
                        android:includeFontPadding="false"
                        android:text="Service Vendor"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_9ssp"
                        app:fontName="Poppins-Regular.ttf"
                        app:layout_constraintStart_toEndOf="@id/img_person_card"
                        app:layout_constraintTop_toTopOf="@id/img_person_card" />

                    <com.mamits.citymatic.ui.customviews.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:includeFontPadding="false"
                        android:text="Not assigned yet"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        app:fontName="Poppins-Regular.ttf"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/img_person_card"
                        app:layout_constraintTop_toBottomOf="@id/txt_vendor" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="@dimen/_5sdp"
                        app:cardElevation="@dimen/dimen_0dp"
                        app:contentPadding="@dimen/_15sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:layout_gravity="center"
                                android:src="@drawable/phone_call_icon"
                                app:tint="@color/tab_unselect" />

                            <com.mamits.citymatic.ui.customviews.CustomTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:includeFontPadding="false"
                                android:text="Call"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_12ssp"
                                android:visibility="gone"
                                app:fontName="Poppins-Regular.ttf" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>


</layout>