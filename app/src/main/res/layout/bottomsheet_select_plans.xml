<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/top_corner_shape"
    android:backgroundTint="@color/dim_gray"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="30dp"
    android:paddingEnd="15dp"
    android:paddingBottom="40dp">

    <com.mamits.citymatic.ui.customviews.CustomTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="Select Plan"
        android:textColor="@color/black"
        android:textSize="@dimen/_12ssp"
        app:fontName="Poppins-Medium.ttf" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_plans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        tools:itemCount="2"
        tools:listitem="@layout/plans_item_list" />


</LinearLayout>


